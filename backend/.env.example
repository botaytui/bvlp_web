DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,api.bvlbpbl.vn
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,https://bvlbpbl.vn,https://www.bvlbpbl.vn

# Development defaults to SQLite when DB_ENGINE is omitted.
# Production local server must use PostgreSQL.
DB_ENGINE=postgresql
DB_NAME=hospital_website
DB_USER=hospital_app
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=127.0.0.1
DB_PORT=5432
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
